# Copy to .env and fill in what you have. Every adapter falls back to offline/synthetic mode when its key is missing.

# Ofcom API portal (https://api.ofcom.org.uk): Products -> "Mobile Coverage UPRN (Basic)" -> Subscribe;
# then Profile -> Subscriptions -> Show primary key.
OFCOM_API_KEY=

# OpenCellID (https://opencellid.org/register.php) - token used for bulk MCC downloads and getInArea queries.
OPENCELLID_TOKEN=

# Optional: OS Data Hub key (https://osdatahub.os.uk) - only needed for OS Terrain 50 via the API; Copernicus DEM is keyless.
OS_DATAHUB_KEY=

# Optional: Network Rail Open Data / Rail Data Marketplace credentials for CIF timetables (otherwise the YAML timetable is used).
NROD_USERNAME=
NROD_PASSWORD=

# Optional: override the Overpass endpoint (default https://overpass-api.de/api/interpreter)
OVERPASS_URL=
